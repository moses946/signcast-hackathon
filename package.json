{
  "name": "signcast",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <27"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,companion,extension \"npm run dev -w @signcast/server\" \"npm run dev -w @signcast/companion\" \"npm run dev -w @signcast/extension\"",
    "build": "npm run build -w @signcast/companion && npm run build -w @signcast/extension && npm run build -w @signcast/server",
    "start": "node apps/server/dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "package:extension": "npm run build -w @signcast/extension && node scripts/package-extension.mjs",
    "package:submission": "npm run package:extension && node scripts/package-submission.mjs",
    "check:providers": "tsx scripts/check-providers.ts",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "dev:extension:https": "node scripts/extension-https.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/supertest": "^6.0.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "fflate": "^0.8.3",
    "prettier": "^3.9.10",
    "supertest": "^7.1.4",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.0",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  }
}
